# Audio
CONFIG_OPLUS_FEATURE_MM_FEEDBACK=y

# Bluetooth
CONFIG_OPLUS_BT_BUG_STABILITY=y

# Filesystems
CONFIG_EXFAT_FS=y

# Haptics
CONFIG_AW8697_HAPTIC=m

# Logging
CONFIG_LOG_BUF_SHIFT=20

# Misc
CONFIG_SIM_DETECT=y

# Net
CONFIG_IP_NF_TARGET_TTL=y

# Param
CONFIG_PARAM_READ_WRITE=y

# Platform
CONFIG_OPLUS_SYSTEM_KERNEL=y
CONFIG_OPLUS_SYSTEM_KERNEL_QCOM=y

# Sensors
CONFIG_OPLUS_SENSOR_FB_QC=y

# SoC
CONFIG_MEM_SHARE_QMI_SERVICE=y
CONFIG_OEM_QMI=y
CONFIG_OPLUS_GPIO=y

# Stability
CONFIG_OPLUS_BUG_STABILITY_EFFECTON_QGKI=y
CONFIG_OPLUS_BUG_STABILITY=y

# UFS
# CONFIG_FS_HPB is not set
# CONFIG_SCSI_SKHPB is not set
# CONFIG_UFSHPB is not set
CONFIG_OPLUS_FEATURE_PADL_STATISTICS=y
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_UFSHID_POC=y
CONFIG_UFSTW=y
CONFIG_UFSTW_BOOT_ENABLED=y
CONFIG_UFSTW_IGNORE_GUARANTEE_BIT=y

# WiFi
CONFIG_OPLUS_FEATURE_WIFI_BDF=y
CONFIG_OPLUS_FEATURE_WIFI_MAC=y
CONFIG_QCA_CLD_WLAN=m

# 1. 核心调度与共享内存父级依赖（必开）
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_COMMON=y
CONFIG_DMA_SHARED_BUFFER=y

# 2. 高通 SMEM 与板型信息依赖链（必开）
CONFIG_RPMSG=y
CONFIG_RPMSG_CHAR=y
CONFIG_QCOM_GLINK=y
CONFIG_QCOM_GLINK_PKT=y
CONFIG_QCOM_SMEM=y
CONFIG_OPLUS_PROJECT_INFO=y

# 3. 高通 QMI 通信协议框架（必开）
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_QMI_HELPERS=y

# 4. 禁用用不到且引发 link 错误的外设/调试模块（明确置为 is not set）
# CONFIG_HID_QVR is not set
# CONFIG_MSM_RDBG is not set
# CONFIG_SLIMBUS_MSM_NGD is not set
